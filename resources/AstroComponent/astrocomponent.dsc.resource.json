{
    "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
    "type": "AstroStack/Component",
    "version": "0.1.0",
    "description": "Tracks a single astrophotography stack component (Application, Dataset, or the pinned NinaPlugin set) against a single component file under manifest/components/*.json.",
    "tags": [ "astrophotography", "astropc" ],
    "get": {
        "executable": "pwsh",
        "args": [
            "-NoLogo",
            "-NonInteractive",
            "-NoProfile",
            "-ExecutionPolicy", "Bypass",
            "-File", "./Component.resource.ps1",
            "get"
        ],
        "input": "stdin"
    },
    "set": {
        "executable": "pwsh",
        "args": [
            "-NoLogo",
            "-NonInteractive",
            "-NoProfile",
            "-ExecutionPolicy", "Bypass",
            "-File", "./Component.resource.ps1",
            "set"
        ],
        "input": "stdin",
        "return": "state"
    },
    "test": {
        "executable": "pwsh",
        "args": [
            "-NoLogo",
            "-NonInteractive",
            "-NoProfile",
            "-ExecutionPolicy", "Bypass",
            "-File", "./Component.resource.ps1",
            "test"
        ],
        "input": "stdin",
        "return": "state"
    },
    "schema": {
        "embedded": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [ "ManifestPath" ],
            "additionalProperties": true,
            "properties": {
                "ManifestPath": { "type": "string", "description": "Path to a single component file under manifest/components/*.json." },
                "ArtifactMapPath": { "type": "string", "description": "Path to wgfetch's schemaVersion 1 PackageIdentifier-to-artifact-path mapping file; required for Set." },
                "InDesiredState": { "type": "boolean", "readOnly": true }
            }
        }
    },
    "exitCodes": {
        "0": "Success",
        "1": "Error - see stderr for detail"
    }
}
